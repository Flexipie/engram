{
  "name": "engram",
  "workspaces": ["packages/sdk"],
  "version": "0.1.0",
  "description": "Persistent project intelligence layer for AI coding agents",
  "type": "module",
  "bin": {
    "engram": "./dist/cli/index.js"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run src/__tests__/e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.0",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "uuid": "^11.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.2"
  }
}
